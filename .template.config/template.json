{
  "$schema": "http://json.schemastore.org/template",
  "author": "Muhammad Fariz",
  "classifications": [ "Web", "WebAPI", "Clean Architecture", "Template" ],
  "name": ".NET Clean Architecture Web API Template",
  "identity": "MyCleanApi.CleanArchitecture.Template",
  "shortName": "cleanapi",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "MyCleanApi",
  "preferNameDirectory": true,
  "symbols": {
    "Database": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "postgres",
          "description": "PostgreSQL with Npgsql EF Core provider"
        },
        {
          "choice": "sqlserver",
          "description": "Microsoft SQL Server EF Core provider"
        }
      ],
      "defaultValue": "postgres",
      "description": "Select the database provider (postgres | sqlserver)"
    },
    "DatabaseProvider": {
      "type": "generated",
      "generator": "switch",
      "replaces": "\"PostgreSQL\"",
      "parameters": {
        "cases": [
          { "condition": "(Database == 'sqlserver')", "value": "\"SqlServer\"" },
          { "condition": "", "value": "\"PostgreSQL\"" }
        ]
      }
    },
    "DatabaseConnectionString": {
      "type": "generated",
      "generator": "switch",
      "replaces": "Host=localhost;Port=5432;Database=MyCleanDb;Username=postgres;Password=postgres;",
      "parameters": {
        "cases": [
          {
            "condition": "(Database == 'sqlserver')",
            "value": "Server=localhost,1433;Database=MyCleanDb;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;"
          },
          {
            "condition": "",
            "value": "Host=localhost;Port=5432;Database=MyCleanDb;Username=postgres;Password=postgres;"
          }
        ]
      }
    },
    "ApiStyle": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "controllers",
          "description": "Classic ASP.NET Core API Controllers"
        },
        {
          "choice": "minimal",
          "description": "Modern Modular ASP.NET Core Minimal APIs"
        }
      ],
      "defaultValue": "controllers",
      "description": "Select the API style (controllers | minimal)"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(Database == 'sqlserver')",
          "exclude": [ "docker-compose.yml" ],
          "rename": { "docker-compose.sqlserver.yml": "docker-compose.yml" }
        },
        {
          "condition": "(Database != 'sqlserver')",
          "exclude": [ "docker-compose.sqlserver.yml" ]
        },
        {
          "exclude": [
            "PROJECT_PLAN.md",
            "scripts/test-template.ps1",
            "packaging/**",
            "dist/**",
            "**/.github/**",
            "**/bin/**",
            "**/obj/**",
            "**/.vs/**",
            "**/.vscode/**",
            "**/.git/**",
            "**/.dotnet/**",
            "**/.nuget/**",
            "**/logs/**",
            "**/*.log",
            "**/*.user"
          ]
        }
      ]
    }
  ]
}
